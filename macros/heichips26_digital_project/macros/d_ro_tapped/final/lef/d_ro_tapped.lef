VERSION 5.7 ;
  NOWIREEXTENSIONATPIN ON ;
  DIVIDERCHAR "/" ;
  BUSBITCHARS "[]" ;
MACRO d_ro_tapped
  CLASS BLOCK ;
  FOREIGN d_ro_tapped ;
  ORIGIN 0.000 0.000 ;
  SIZE 100.000 BY 60.000 ;
  PIN VGND
    DIRECTION INOUT ;
    USE GROUND ;
    PORT
      LAYER Metal2 ;
        RECT 16.840 3.560 18.840 53.140 ;
    END
    PORT
      LAYER Metal2 ;
        RECT 66.840 3.560 68.840 53.140 ;
    END
    PORT
      LAYER Metal3 ;
        RECT 3.840 18.780 96.000 20.780 ;
