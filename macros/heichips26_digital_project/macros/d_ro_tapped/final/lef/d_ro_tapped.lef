      LAYER Metal3 ;
        RECT 0.000 46.420 0.400 46.820 ;
    END
  END invsel[4]
  PIN osc
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    ANTENNADIFFAREA 0.708600 ;
    PORT
      LAYER Metal3 ;
        RECT 99.600 29.620 100.000 30.020 ;
    END
  END osc
  OBS
      LAYER GatPoly ;
        RECT 3.840 3.630 96.000 53.070 ;
      LAYER Metal1 ;
        RECT 3.840 3.560 96.000 53.140 ;
      LAYER Metal2 ;
