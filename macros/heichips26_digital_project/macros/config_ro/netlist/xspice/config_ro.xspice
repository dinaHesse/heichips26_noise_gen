.model todig_1v2 adc_bridge(in_high=0.7999999999999999 in_low=0.39999999999999997 rise_delay=500p fall_delay=500p)
.model toana_1v2 dac_bridge(out_high=1.2 out_low=0)

.model ddflop d_dff(ic=0 rise_delay=50p fall_delay=50p)
.model dlatch d_dlatch(ic=0 rise_delay=50p fall_delay=50p)
.model dzero d_pulldown(load=250f)
.model done d_pullup(load=250f)

AA2D1 [a_VGND] [dig_VGND] todig_1v2
AA2D2 [a_VPWR] [dig_VPWR] todig_1v2
AA2D3 [a_enable] [enable] todig_1v2
AD2A1 [osc] [a_osc] toana_1v2
AA2D4 [a_stage_en_0_] [stage_en_0_] todig_1v2
AA2D5 [a_stage_en_1_] [stage_en_1_] todig_1v2
AA2D6 [a_stage_en_2_] [stage_en_2_] todig_1v2
AA2D7 [a_stage_en_3_] [stage_en_3_] todig_1v2

