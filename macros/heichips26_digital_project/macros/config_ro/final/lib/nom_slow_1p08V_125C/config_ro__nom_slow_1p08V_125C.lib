	}
      }
      timing() {
        related_pin : "stage_en[3]";
        timing_sense : positive_unate;
        timing_type : combinational;
	cell_rise(template_1) {
          index_1("0.00100,  0.02340,  0.03900,  0.06480,  0.10800,  0.18000,  0.30000");
          values("0.83701,0.94281,1.01093,1.12319,1.31134,1.62402,2.14508");
	}
	rise_transition(template_1) {
          index_1("0.00100,  0.02340,  0.03900,  0.06480,  0.10800,  0.18000,  0.30000");
          values("0.03627,0.16231,0.25850,0.41849,0.68692,1.13986,1.88167");
	}
	cell_fall(template_1) {
